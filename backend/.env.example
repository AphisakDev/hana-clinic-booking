# Copy to .env and adjust.
# postgres (default) or memory (no database, sample data, resets on restart)
DATA_SOURCE=postgres
DATABASE_URL=postgresql://clinic:clinic@localhost:5432/clinic_booking?schema=public
# Optional direct connection URL for Prisma migrations (e.g. Supabase, Neon)
# DIRECT_URL=postgresql://postgres:password@localhost:5432/clinic_booking
PORT=3000
# Comma-separated origins allowed to call the API. Empty = allow all (dev only).
CORS_ORIGIN=http://localhost:4200
# Secret used to sign staff login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# Show OTP codes on screen instead of only sending SMS. Demo sites only!
# (Always on when DATA_SOURCE=memory.)
OTP_SHOW_CODE=false
