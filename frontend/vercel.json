{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/clinic-booking-web/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://hana-clinic-booking.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
